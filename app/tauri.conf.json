{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RekordJog",
  "version": "2.0.5",
  "identifier": "app.rekordjog.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RekordJog",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "publisher": "RekordJog",
    "copyright": "MIT License",
    "shortDescription": "Use a Numark Mixtrack Go with rekordbox",
    "longDescription": "RekordJog makes the Numark Mixtrack Go work in rekordbox with jog wheels, pads and LEDs by presenting it as a Pioneer DDJ-SX.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
